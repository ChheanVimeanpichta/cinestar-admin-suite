# ================================================================
# 1. LOCAL DEVELOPMENT (.env) — NO DOCKER NEEDED
# ================================================================
NODE_ENV=development
PORT=5000

# AWS RDS MySQL connection string:
# Format: mysql://USERNAME:PASSWORD@RDS_ENDPOINT:3306/DATABASE_NAME
DATABASE_URL="mysql://admin:your_password@database-2.co2sxxgtd0y5.us-east-1.rds.amazonaws.com:3306/cinestar?connect_timeout=15"

JWT_SECRET=dev-secret-key-123
ADMIN_JWT_SECRET=dev-secret-key-123

